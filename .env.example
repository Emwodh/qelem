# Supabase Configuration for Qelem Matric Prep (Grades 9–12)
# Obtain these credentials from your Supabase Dashboard: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Auth0 Authentication Configuration
# Generate a 32-byte secret with: openssl rand -hex 32
AUTH0_SECRET=your-32-character-secret
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Administrative Console Passkey & API Protection
ADMIN_SECRET_KEY=your-secure-admin-passkey
ADMIN_SEED_SECRET=your-database-seed-passkey


