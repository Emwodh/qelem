# ==============================================================================
# Qelem Platform Environment Configuration Template
# Copy this file to .env.local and configure your secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Auth Credentials
# Obtain from: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Auth0 OIDC Authentication Configuration
# Generate a 32+ byte secret with: openssl rand -hex 32
# ------------------------------------------------------------------------------
AUTH0_SECRET=your-32-byte-hex-secret
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# ------------------------------------------------------------------------------
# 3. Rate Limiting (Optional - Upstash Redis)
# If not configured, in-memory rate limiting is used
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ------------------------------------------------------------------------------
# 4. Optional Administrative Overrides
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@qelem.et
